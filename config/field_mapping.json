{
  "description": "Mapping fichier catalogue Compulocks/Maclocks vers PrestaShop 1.7.4 pour Elockstore.com",
  "prestashop_version": "1.7.4",
  "site": "elockstore.com",
  "supplier_name": "Compulocks",
  "csv_settings": {
    "input_delimiter": "\t",
    "input_encoding": "utf-8-sig",
    "output_delimiter": ";",
    "output_encoding": "utf-8"
  },
  "source_columns": {
    "PN": {
      "prestashop_field": "Reference",
      "also_maps_to": "Supplier reference"
    },
    "UPC": {
      "prestashop_field": "EAN13",
      "transform": "fix_scientific_upc"
    },
    "HS Code": {
      "prestashop_field": "Feature",
      "feature_name": "Code douanier"
    },
    "Bundle/Simple": {
      "internal_use": true,
      "note": "S=Simple, B=Bundle"
    },
    "Weight (lb)": {
      "prestashop_field": "Weight",
      "transform": "lbs_to_kg"
    },
    "Dimensions (In)": {
      "prestashop_fields": ["Width", "Height", "Depth"],
      "transform": "inches_to_cm_split"
    },
    "Color": {
      "prestashop_field": "Feature",
      "feature_name": "Couleur"
    },
    "Material": {
      "prestashop_field": "Feature",
      "feature_name": "Matériau"
    },
    "COO": {
      "prestashop_field": "Feature",
      "feature_name": "Pays d'origine"
    },
    "Marketing Name": {
      "prestashop_field": "Name *",
      "transform": "translate_name"
    },
    "Web-site link": {
      "internal_use": true,
      "note": "Lien fournisseur, non importé"
    },
    "Link to the User Guide": {
      "prestashop_field": "Feature",
      "feature_name": "Guide utilisateur"
    },
    "Link to the Spec Sheet": {
      "prestashop_field": "Feature",
      "feature_name": "Fiche technique"
    },
    "Compatibility": {
      "prestashop_field": "Feature",
      "feature_name": "Compatibilité",
      "also_append_to": "Description"
    },
    "Picture 1": {
      "prestashop_field": "Image URLs (x,y,z...)",
      "position": 1
    },
    "Picture 2": {
      "prestashop_field": "Image URLs (x,y,z...)",
      "position": 2
    },
    "Picture 3": {
      "prestashop_field": "Image URLs (x,y,z...)",
      "position": 3
    },
    "Picture 4": {
      "prestashop_field": "Image URLs (x,y,z...)",
      "position": 4
    },
    "Long description": {
      "prestashop_field": "Description",
      "transform": "translate_description"
    },
    "Marketing Bullet Points": {
      "prestashop_field": "Short description",
      "transform": "bullets_to_html_list"
    },
    "Marketing Bullet Points as list": {
      "internal_use": true,
      "note": "Version alternative, non utilisé"
    }
  },
  "default_values": {
    "Active (0/1)": "1",
    "Available for order (0/1)": "1",
    "Show price (0/1)": "1",
    "Visibility": "both",
    "Condition": "new",
    "Minimal quantity": "1",
    "Tax rule ID": "1",
    "On sale (0/1)": "0",
    "Available online only (0/1)": "0",
    "Supplier": "Compulocks",
    "Manufacturer": "Compulocks",
    "Quantity": "0",
    "Delivery time of in-stock products": "Livraison sous 3-7 jours ouvrés",
    "Delivery time of out-of-stock products": "Livraison sous 10-21 jours ouvrés",
    "Text when in stock": "En stock - Expédition sous 48h",
    "Text when backorder allowed": "Sur commande - Livraison sous 2-3 semaines"
  },
  "category_rules": [
    {"pattern": "enclosure|space enclosure", "category": "Accueil > Supports et Fixations > Boîtiers Tablettes"},
    {"pattern": "kickstand", "category": "Accueil > Supports et Fixations > Supports Bureau"},
    {"pattern": "wall mount|wallmount", "category": "Accueil > Supports et Fixations > Fixations Murales"},
    {"pattern": "floor stand|floorstand|kiosk", "category": "Accueil > Supports et Fixations > Bornes et Totems"},
    {"pattern": "desk mount|desk stand|rise", "category": "Accueil > Supports et Fixations > Supports Bureau"},
    {"pattern": "arm|reach|articulating", "category": "Accueil > Supports et Fixations > Bras Articulés"},
    {"pattern": "charging|usb.*port|dock", "category": "Accueil > Solutions de Recharge"},
    {"pattern": "cable lock|lock slot|t-bar", "category": "Accueil > Câbles et Verrous de Sécurité"},
    {"pattern": "case|edge case|rugged", "category": "Accueil > Coques et Protections"},
    {"pattern": "cling|grip|holder", "category": "Accueil > Supports et Fixations > Supports Universels"},
    {"pattern": "ledge|macbook|laptop", "category": "Accueil > Sécurité Laptop"},
    {"pattern": "pos|payment|terminal", "category": "Accueil > Solutions Point de Vente"},
    {"pattern": "medical|hospital|patient", "category": "Accueil > Solutions Médicales"},
    {"pattern": "default", "category": "Accueil > Supports et Fixations"}
  ],
  "color_translation": {
    "Black": "Noir",
    "White": "Blanc",
    "Silver": "Argent",
    "Gray": "Gris",
    "Grey": "Gris",
    "Red": "Rouge",
    "Blue": "Bleu",
    "Pink": "Rose",
    "Gold": "Or",
    "Transparent": "Transparent"
  },
  "material_translation": {
    "ALUMINUM": "Aluminium",
    "Aluminium": "Aluminium",
    "STEEL": "Acier",
    "Steel": "Acier",
    "Plastic": "Plastique",
    "Rubber": "Caoutchouc",
    "POLYCARBONATE": "Polycarbonate",
    "Metal": "Métal"
  },
  "country_translation": {
    "IL": "Israël",
    "CN": "Chine",
    "US": "États-Unis",
    "TW": "Taïwan",
    "DE": "Allemagne"
  },
  "price_config": {
    "note": "Le fichier Compulocks ne contient pas de prix. Utilisez un fichier prix séparé ou configurez les prix manuellement.",
    "price_file": "prix_elockstore.csv",
    "price_file_columns": {
      "reference": "PN",
      "prix_achat_ht": "Cost",
      "prix_vente_ht": "Price_HT",
      "prix_vente_ttc": "Price_TTC"
    },
    "default_margin_percent": 45,
    "tva_rate": 20
  }
}
